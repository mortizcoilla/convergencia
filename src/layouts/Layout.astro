---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}
const {
  title = "Convergencia — Asesoramiento a equipos educativos",
  description = "Un espacio de formación y asesoramiento que nace desde la experiencia educativa. Acompañamos a docentes, equipos directivos y equipos PIE.",
  ogImage = "/images/og-image.png",
} = Astro.props;

const siteUrl = "https://convergencia.pro";
const fullUrl = new URL(Astro.url.pathname, siteUrl).toString();
const fullImage = new URL(ogImage, siteUrl).toString();

// JSON-LD: Organization + ProfessionalService + ContactPoint
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}#organization`,
      "name": "Convergencia",
      "url": siteUrl,
      "logo": `${siteUrl}/images/og-image.png`,
      "description": description,
      "sameAs": [
        "https://instagram.com/convergencia.formacion",
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer support",
        "email": "hola@convergencia.cl",
        "availableLanguage": ["es-CL", "es"],
      },
    },
    {
      "@type": "ProfessionalService",
      "@id": `${siteUrl}#service`,
      "name": "Convergencia — Asesoramiento a Equipos Educativos",
      "url": siteUrl,
      "image": fullImage,
      "description": description,
      "priceRange": "$$",
      "areaServed": {
        "@type": "Country",
        "name": "Chile",
      },
      "provider": { "@id": `${siteUrl}#organization` },
      "serviceType": [
        "Capacitación docente",
        "Asesoría pedagógica",
        "Acompañamiento a equipos directivos",
        "Capacitación PIE",
        "Diseño Universal para el Aprendizaje",
      ],
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#081B3A" />
    <link rel="canonical" href={fullUrl} />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Convergencia — Asesoramiento a equipos educativos" />
    <meta property="og:site_name" content="Convergencia" />
    <meta property="og:locale" content="es_CL" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImage} />
    <meta name="twitter:image:alt" content="Convergencia — Asesoramiento a equipos educativos" />

    <!-- Fonts: Manrope (sans) + Lora (serif) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700&family=Lora:ital,wght@1,400;1,500&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD: datos estructurados -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      // Reveal en viewport — observador compartido
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-visible");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
      );

      // Indexar hijos para stagger
      document.querySelectorAll("[data-reveal-group]").forEach((g) => {
        Array.from(g.children).forEach((child, i) => {
          (child as HTMLElement).style.setProperty("--i", String(i));
        });
      });

      document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
