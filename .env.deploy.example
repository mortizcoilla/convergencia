# Credenciales SFTP/SSH de HostGator.
# 1. Copia este archivo como .env.deploy.local
# 2. Llena los valores reales
# 3. .env.deploy.local está en .gitignore — no se sube al repo
#
# Para SSH key (recomendado):
#   1. Genera key local:  ssh-keygen -t ed25519 -f ~/.ssh/convergencia_hostgator
#   2. Sube la pública:   scp ~/.ssh/convergencia_hostgator.pub user@host:~/keys/
#   3. En cPanel: SSH Access > Manage SSH Keys > Import Key
#   4. Pega SFTP_KEY abajo apuntando a la privada

SFTP_HOST=gatorXXXX.hostgator.com
SFTP_USER=tu_usuario_cpanel
SFTP_PORT=22
SFTP_REMOTE=~/public_html/

# Opción A: SSH key (recomendado)
# SFTP_KEY=C:\Users\morti\.ssh\convergencia_hostgator

# Opción B: password (requiere instalar sshpass: scoop install sshpass)
# SFTP_PASSWORD=tu_password_cpanel
